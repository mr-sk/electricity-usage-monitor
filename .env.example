# Optional local defaults for private deployments. Do not commit .env.
ELECTRICITY_PROVIDER=psegliny-rate194
ELECTRICITY_TZ=America/New_York
ELECTRICITY_CYCLE_START=2026-06-26
ELECTRICITY_CYCLE_END=2026-07-29

# MyMeter/PSEG LI daily download support.
MYMETER_BASE_URL=https://mysmartenergy.psegliny.com
MYMETER_USERNAME=your_email@example.com
MYMETER_PASSWORD=your_password_here
MYMETER_STORAGE_STATE=/path/to/mymeter-storage.json
MYMETER_DOWNLOAD_REQUEST=/path/to/download-request.json
MYMETER_USE_CAPTURED_TOKEN=1
